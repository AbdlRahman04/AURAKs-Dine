# =============================================================================
# Database Configuration
# =============================================================================
# Use ONE of the options below. The app auto-detects Neon vs local/Render Postgres
# from the connection string and picks the right driver.
#
# .env.local overrides .env when present — use it for local Postgres so you
# can keep a cloud URL in .env for deployment without changing files.

# --- Option A: Local PostgreSQL (dev) — prefer putting this in .env.local ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickdineflow

# --- Option B: Render Postgres (deploy) ---
# DATABASE_URL is injected by Render from the linked database (see render.yaml).

# --- Option C: Neon (optional cloud) ---
# Use the *pooled* connection string from the Neon dashboard (required for sessions).
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Active DATABASE_URL (fill in for your chosen target):
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Session Secret
# Generate a random secret string for session encryption (you can use any random string)
# Example: openssl rand -base64 32
SESSION_SECRET=your_random_secret_string_here

# Test Admin Credentials (used by npm run db:seed) — local/demo only
ADMIN_EMAIL=admin@quickdine.com
ADMIN_PASSWORD=admin


# Stripe Configuration
# Get your Stripe keys from https://dashboard.stripe.com/test/apikeys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Optional: Testing Stripe Key (alternative to STRIPE_SECRET_KEY)
# TESTING_STRIPE_SECRET_KEY=sk_test_your_testing_key_here

# Server Port
# Default is 5000 if not specified
PORT=5000
